#!/bin/sh
# Keep the installed entry point; Python already belongs to the bot runtime.
BOT_DIR="${BOT_DIR:-/opt/etc/bot}"
python_bin="/opt/bin/python3"
[ -x "$python_bin" ] || python_bin="$(command -v python3 2>/dev/null || true)"
if [ -z "$python_bin" ] || [ ! -f "$BOT_DIR/dns_route_generator.py" ]; then
  echo "Не найден генератор DNS-правил; рабочая конфигурация сохранена." >&2
  exit 1
fi
export PYTHONDONTWRITEBYTECODE=1
exec "$python_bin" "$BOT_DIR/dns_route_generator.py" "$@"
